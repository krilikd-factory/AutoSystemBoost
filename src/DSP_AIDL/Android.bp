// Build recipe for the ASB AIDL loudness effect -> libasbdsp_aidl.so.
//
// Modelled on AOSP's own effects (hardware/interfaces/audio/aidl/default). Since
// asb_effect_aidl.cpp now subclasses EffectImpl, the build must ALSO compile the
// EffectImpl/EffectThread/EffectContext sources and see their headers. AOSP exposes
// both through:
//   * defaults: "aidlaudioeffectservice_defaults"  -> effect-impl headers + all the
//     AIDL/binder/fmq deps, resolved version-independently for the branch you build on.
//   * srcs: ":effectCommonFile"                     -> EffectImpl.cpp, EffectThread.cpp,
//     EffectContext.cpp (the base-class implementation each effect links in).
//   * static_libs: "libaudioaidlranges"             -> the MAKE_RANGE() helper used to
//     declare the capability ranges.
// These three are exactly what e.g. libloudnessenhanceraidl uses. If your (possibly
// filtered) tree lacks the "aidlaudioeffectservice_defaults" default or the
// ":effectCommonFile" filegroup, copy them from
// hardware/interfaces/audio/aidl/default/Android.bp into your tree, or add that
// directory to your checkout — they are not part of the plain NDK.

cc_library_shared {
    name: "libasbdsp_aidl",
    vendor: true,
    // One pass emits both arm64 and arm so the module ships lib64/soundfx and
    // lib/soundfx. Without this soong builds only the target's primary arch.
    compile_multilib: "both",
    srcs: [
        "asb_effect_aidl.cpp",
        ":effectCommonFile",
    ],
    defaults: [
        "aidlaudioeffectservice_defaults",
    ],
    local_include_dirs: ["."],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    static_libs: [
        "libaudioaidlranges",
    ],
    relative_install_path: "soundfx",
    visibility: ["//visibility:public"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
        "-O2",
        "-ffast-math",
    ],
}

// ---------------------------------------------------------------------------
// Second build, against the V2 interface.
//
// A device's effect HAL version is a property of its VENDOR partition, frozen at its
// launch year under Treble/GRF - not of the system image. A OnePlus 13 running Android
// 16 still declares <version>2</version> because its vendor is an Android 15 vintage,
// while a OnePlus 15 declares 3. queryEffect() fills a Descriptor through a plain C ABI
// call, so the struct layout has to match exactly: a v3-built library is not something a
// v2 factory can load, and it never gets as far as dlopen. That is why the OP13 saw
// set=-19 initCheck=-19 (NO_INIT) with the config patched and the library in place.
//
// Both versions are frozen in one tree - the CI log lists "1 2 3 current" under
// aidl_api/android.hardware.audio.effect - so this needs no second AOSP branch. The only
// thing aidlaudioeffectservice_defaults does that we cannot reuse is pin the interface
// via "latest_android_hardware_audio_effect_ndk_shared"; everything else below is copied
// verbatim from it, so the two builds differ in exactly one dependency.
cc_defaults {
    name: "asb_aidleffect_v2_defaults",
    // Every dependency that CARRIES a version is pinned explicitly. The "latest_*"
    // defaults resolve to whatever this tree froze last (V4 here), and soong refuses a
    // module that reaches two versions of one aidl_interface by any path. Each such
    // dependency had to be found from a build log, one per run, so they are all listed
    // here rather than inherited:
    //   effect            V2  - the interface we are building for
    //   common.types      V3  - what effect-V2 itself pulls; latest_* gave V4
    //   libaudioaidlranges    - dropped entirely, it hard-links effect-V3 (see below)
    //   conversion_common     - dropped, it is built against latest and nothing in
    //                           asb_effect_aidl.cpp or the effect-impl sources converts
    //                           between HIDL and AIDL audio types
    defaults: [],
    vendor: true,
    shared_libs: [
        "android.hardware.audio.effect-V2-ndk",
        "android.media.audio.common.types-V3-ndk",
        // libaudioaidlcommon is NOT here either. AOSP lists it under shared_libs, not
        // header_libs, so it is a real library built against the tree's latest interface
        // and would drag common.types-V4 back in - the exact conflict this whole defaults
        // block exists to avoid. Dropping it is weakly better than testing it: if the
        // effect-impl sources genuinely need a symbol from it, the build says which one,
        // and keeping it guarantees the version clash instead.
        "libaudioutils",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "liblog",
        "libutils",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
    header_libs: [
        "libaudioaidl_headers",
        "libaudio_system_headers",
        "libsystem_headers",
    ],
    // Utils.h, as a raw include path rather than a dependency.
    //
    // EffectContext.h does #include <Utils.h>, which lives in the audio aidl common
    // directory and normally arrives with libaudioaidlcommon. That module was dropped
    // from this variant because it is built against the tree's latest interface and would
    // drag common.types-V4 back in, which is the conflict this whole defaults block exists
    // to avoid. An include_dirs entry gives the compiler the header and creates no
    // dependency edge at all, so there is nothing for soong to version-resolve.
    include_dirs: [
        "hardware/interfaces/audio/aidl/common/include",
    ],
}

cc_library_shared {
    name: "libasbdsp_aidl_v2",
    compile_multilib: "both",
    srcs: [
        "asb_effect_aidl.cpp",
        ":effectCommonFile",
    ],
    defaults: [
        "asb_aidleffect_v2_defaults",
    ],
    local_include_dirs: ["."],
    // NO libaudioaidlranges here, unlike the V3 module above.
    //
    // That static library is built against the tree's LATEST interface, so it drags in
    // android.hardware.audio.effect-V3-ndk, which in turn pulls audio.common-V4 while our
    // effect-V2-ndk pulls audio.common-V3. Soong refuses the module outright: "depends on
    // multiple versions of the same aidl_interface". The dependency path in the build log
    // is unambiguous - libaudioaidlranges -> effect-V3-ndk -> audio.common-V4-ndk.
    //
    // We do not actually need what it compiles. MAKE_RANGE is a macro from the effect-impl
    // headers, which arrive through libaudioaidl_headers in the defaults above, and the
    // ranges themselves are declared in asb_effect_aidl.cpp. The static library carries the
    // range TABLES for AOSP's own effects, and none of ours come from there.
    //
    // If this turns out to export a symbol we do link, the build will name it, and the
    // answer is to copy that one definition in rather than take the whole library back.
    relative_install_path: "soundfx",
    visibility: ["//visibility:public"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
        "-O2",
        "-ffast-math",
    ],
}

// Attacher daemon. NOT vendor: it links libaudioclient, which is a system library and is
// not available to vendor modules. It is installed under the module's own directory and
// launched from service.sh, so it never needs to live in /vendor.
cc_binary {
    name: "asb_dsp_attach",
    srcs: ["asb_dsp_attach.cpp"],
    compile_multilib: "64",
    shared_libs: [
        "libaudioclient",
        "libaudiofoundation",
        "libbinder",
        "libutils",
        "liblog",
        "libcutils",
        // AttributionSourceState (the AudioEffect ctor argument) is generated into
        // libpermission; without it the link fails with
        // "undefined symbol: _ZTVN7android7content22AttributionSourceStateE".
        "libpermission",
    ],
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],
}
