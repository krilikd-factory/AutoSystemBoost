    "athena_service": {
      "name": "Athena Background Killer",
      "desc": "OxygenOS has its own background app killer - com.oplus.athena - and AthenaService is the part that decides what to kill. It is why a messenger left in the background stops delivering notifications until you reopen it, which no amount of battery whitelisting fixes because it is not Android's Doze doing it. Off disables that one component; the rest of the package keeps running, so thermal reporting and the settings panels are unaffected. Fully reversible: the previous state is recorded before anything changes and put back when you set this to stock or remove the module. Expect more RAM in use and slightly more drain - that is what keeping apps alive costs."
    },
    "net_rps": {
      "name": "Spread Network Load",
      "desc": "Which cores handle incoming network packets. Stock leaves every packet on the one core the interrupt landed on, which caps throughput on fast WiFi and pins that core high. Little spreads the work across the efficiency cluster; all uses every core. Waking a second core costs a little CPU, so this earns its keep on a fast link and loses on a slow one.",
      "descOpt": {
        "stock": "Every packet stays on the core its interrupt landed on - Android's own behaviour.",
        "little": "Spread across the efficiency cluster. The safer of the two.",
        "all": "Every core. Best throughput on fast WiFi, most CPU woken."
      }
    },
    "net_txqueue": {
      "name": "Transmit Queue",
      "desc": "How many packets may wait to be sent. The stock 1000 is a wired-Ethernet default from the 1990s that survived into wireless drivers; on a link as variable as WiFi a deep queue mostly adds latency under load rather than throughput. If uploads feel slower, go back to stock.",
      "descOpt": {
        "stock": "1000 packets, as the driver ships.",
        "short": "256. Less delay under load, same throughput on most links.",
        "shorter": "128. Lowest latency; can cost throughput on a very fast link."
      }
    }
  },
